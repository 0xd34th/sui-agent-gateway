    "@mysten/sui": "^2.16.2",
    "@pythnetwork/pyth-sui-js": "^2.2.0",
    "@scallop-io/sui-scallop-sdk": "^3.0.2",
    "@suilend/sdk": "^3.0.3",
    "@suilend/springsui-sdk": "^3.0.1",
    "@suilend/sui-fe": "^3.0.2",
    "aftermath-ts-sdk": "^2.0.1",
